#--- Ensamblador a usar
AS=gpasm
ASFLAGS=-w 2 -a inhx8m
 
#-- Ejemplos 
NAME1=skybot-monitor
 
#---------------------------
#       OBJETIVOS
#---------------------------
all: $(NAME1).hex 
 
clean:
	rm -f *.hex *.lst *.cod *.bak *~
	
 
#-----------------------
# REGLAS GENERICAS
#-----------------------
#-- Ensamblado
%.hex : %.asm ; $(AS) $(ASFLAGS) $<
	
